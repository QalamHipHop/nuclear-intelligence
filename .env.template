# ============================================================
# Nuclear Intelligence v4.0 - Configuration Template
# Copy this to .env and fill in your API keys
# All providers are FREE - no credit card needed!
# ============================================================

# ─── HuggingFace Token ───────────────────────────────────────────
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# ─── Free LLM Providers ────────────────────────────────────────
# Get free keys at the links below - no credit card needed!

# DeepSeek V3 - Best free model, 128K context ⭐⭐⭐
# https://console.deepseek.com/api-keys
DEEPSEEK_API_KEY=your_deepseek_key

# Groq LPU - Fastest inference, free tier available ⭐⭐⭐
# https://console.groq.com/api-keys
GROQ_API_KEY=your_groq_key

# Google Gemini 2.0 Flash - Free tier ⭐⭐
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key

# Together AI - Free credits available ⭐⭐
# https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=your_together_key

# OpenRouter - Free daily credits ⭐
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key

# Novita AI - Free tier with DeepSeek V3 ⭐⭐
# https://novita.ai/api-keys
NOVITA_API_KEY=your_novita_key

# Fireworks AI - Free tier available ⭐⭐
# https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=your_fireworks_key

# Cerebras - Free fast inference ⭐⭐⭐
# https://cloud.cerebras.ai/api-key
CEREBRAS_API_KEY=your_cerebras_key

# Cloudflare Workers AI
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_KEY=your_cloudflare_key

# ─── Blockchain ────────────────────────────────────────────────
BLOCKCHAIN_SECRET=nuclear-intelligence-v4-secret
EXTERNAL_NETWORK_RPC=
EXTERNAL_NETWORK_CONTRACT=

# ─── Canonical Runtime Configuration ─────────────────────────────
# All CLI/API/Actions/Space entrypoints read these shared settings.
NI_PROJECT_ROOT=.
LLM_PROVIDER_CHAIN=huggingface,deepseek,groq,gemini,together,fireworks,aimlapi
DEVELOPER_MODE=true
WEB_SEARCH_ENABLED=true
WEB_SEARCH_CACHE_TTL_SECONDS=900
WEB_SEARCH_CACHE_SIZE=128
AUTO_START_LOOP=true
OPERATION_LOOP_INTERVAL_MINUTES=30
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
POW_DIFFICULTY=3
SYNC_TO_HF=true
SYNC_TO_GITHUB=true
HF_DATASET_REPO=Qalam/nuclear-intelligence-dataset

# ─── Autonomous operation ────────────────────────────────────────
# The scheduler runs one bounded, audited cycle per invocation.
AUTONOMY_ENABLED=true
AUTONOMY_ORCHESTRATOR=github
AUTONOMOUS_DEVELOPER_ENABLED=true
EMERGENCY_STOP=false
SPACE_AUTONOMY_ENABLED=false
STATE_RESTORE_ENABLED=true
# Public visitors may read and ask; durable writes remain operator-controlled.
PUBLIC_CYCLE_ENABLED=false
PUBLIC_DATASET_WRITE_ENABLED=false
PUBLIC_MAX_QUERY_CHARS=2000
PUBLIC_RATE_LIMIT_PER_MINUTE=20
# Required for protected API operations in hosted deployments.
OPERATOR_API_TOKEN=

# Canonical quality thresholds
MIN_ACCURACY=70
MIN_NOVELTY=60
MIN_USEFULNESS=60
MIN_OVERALL=65
MIN_COMPLETENESS=40

# Legacy aliases are accepted only by older UI code; prefer canonical names above.
SCIENTIFIC_ACCURACY_THRESHOLD=70
MIN_NOVELTY_THRESHOLD=60
MIN_USEFULNESS_THRESHOLD=60
MIN_OVERALL_SCORE=65
MIN_COMPLETENESS_THRESHOLD=40

# ─── Security ─────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=60

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/nuclear_intelligence.log

# ─── API & UI ───────────────────────────────────────────────────
# Optional in local development; set a long random value in hosted deployments.
# Clients send: Authorization: Bearer <API_KEY>
API_KEY=
# Comma-separated origins; avoid '*' in hosted deployments.
CORS_ORIGINS=http://localhost:7860,http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
GRADIO_PORT=7860
GRADIO_SHARE=false

# ─── HuggingFace Space ─────────────────────────────────────────
SPACE_ID=Qalam/Nuclear-Intelligence